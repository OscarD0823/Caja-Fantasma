{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caja Fantasma · Once Human",
  "version": "1.13.0",
  "identifier": "com.oscard0823.cajafantasma",
  "build": {
    "beforeDevCommand": "node ./node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ./scripts/build-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caja Fantasma · Once Human",
        "width": 1320,
        "height": 850,
        "minWidth": 860,
        "minHeight": 640,
        "center": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Contador de Rueda Visional",
        "width": 430,
        "height": 108,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "OscarD0823",
    "category": "Utility",
    "shortDescription": "Seguimiento de Caja Fantasma para Once Human",
    "longDescription": "Registra recompensas, estima la salida de la Caja Fantasma y controla la Rueda Visional con temporizador, avisos y ventana flotante.",
    "copyright": "Copyright © 2026 OscarD0823",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Caja Fantasma Once Human",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NUY2NzlGQkRFMzQwNDAKUldSQVFPTzluMmRmeVZ3azc2WGNWN0RoME1IR1F6SUVwT2ZtL2xDL1BValZCNWg2TDRJN2ljSXcK",
      "endpoints": [
        "https://github.com/OscarD0823/Caja-Fantasma/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
